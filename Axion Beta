class Handler(BaseHTTPRequestHandler):

    def do_GET(self):

        self.send_response(200)

        self.send_header(
            "Content-Type",
            "text/html; charset=utf-8"
        )

        self.end_headers()

        self.wfile.write(
            HTML.encode("utf-8")
        )


server = HTTPServer(
    ("127.0.0.1",8080),
    Handler
)

print("⚡ Axion Beta 0.1.1")
print("Starting Axion...")

webbrowser.open(
    "http://127.0.0.1:8080"
